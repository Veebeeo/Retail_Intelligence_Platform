# Environments
venv/
.venv/
env/
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Raw and derived data. The leading slash matters: a bare `data/` also
# matches src/retail_intel/data/, which silently excluded the whole data
# package from the repository.
/data/
*.xlsx
*.csv
*.parquet
*.db
*.sqlite3
!tests/fixtures/*.csv

# ML tracking + model artifacts
mlruns/
mlartifacts/
mlflow.db
models/*
!models/.gitkeep
reports/backtest_folds.csv
reports/*.html
!reports/.gitkeep
# Summary reports ARE committed, so the results quoted in the README have a
# backing artifact a reviewer can open without running the pipeline.
!reports/backtest_summary.csv
!reports/champions.csv
!reports/segment_profile.csv
!reports/*.json

# OS / editor
.DS_Store
.idea/
.vscode/
