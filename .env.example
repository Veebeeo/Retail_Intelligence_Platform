# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Full SQLAlchemy URL. Takes precedence over the POSTGRES_* parts below.
# Local docker-compose:
DATABASE_URL=postgresql+psycopg2://retail_user:retail_password@localhost:5430/retail_db
# Zero-dependency local run (no Postgres needed):
# DATABASE_URL=sqlite:///./retail.db

# Used by docker-compose to provision Postgres, and as a fallback when
# DATABASE_URL is unset (host defaults to the compose service name).
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=retail_password
POSTGRES_DB=retail_db
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

# MLflow tracking. Local file store by default; point at the compose service
# (http://localhost:5000) to use the tracking server.
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT=retail_demand_forecasting

# Where the training pipeline writes champion model artifacts for the API.
MODEL_DIR=./models

# Base URL the Streamlit dashboard calls.
API_BASE_URL=http://localhost:8000

# INFO | DEBUG | WARNING
LOG_LEVEL=INFO
